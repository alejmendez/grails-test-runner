{
    "name": "grails-test-runner",
    "displayName": "Grails Test Runner",
    "description": "Ejecuta tests de Grails/Spock con CodeLens",
    "version": "0.1.3",
    "publisher": "alejmendez",
    "icon": "icon.png",
    "engines": {
        "vscode": "^1.74.0"
    },
    "categories": [
        "Testing"
    ],
    "keywords": [
        "grails",
        "spock",
        "groovy",
        "test",
        "gradle"
    ],
    "activationEvents": [
        "onLanguage:groovy",
        "workspaceContains:**/*Spec.groovy",
        "workspaceContains:**/*Tests.groovy",
        "workspaceContains:**/*Test.groovy"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "grails-test-runner.runTest",
                "title": "Run Grails Test"
            },
            {
                "command": "grails-test-runner.runTestClass",
                "title": "Run Grails Test Class"
            },
            {
                "command": "grails-test-runner.rerunTest",
                "title": "Rerun Grails Test"
            },
            {
                "command": "grails-test-runner.rerunTestClass",
                "title": "Rerun Grails Test Class"
            }
        ]
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/alejmendez/grails-test-runner"
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "test": "TS_NODE_PROJECT=tsconfig.test.json mocha"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "^18.0.0",
        "@types/vscode": "^1.74.0",
        "mocha": "^11.7.5",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.0.0"
    },
    "license": "MIT"
}
